# QS Pro backend (Go) - chép thành .env rồi điền. Tên biến giữ nguyên như bản Node.
# Server đọc .env rồi ../.env tính từ thư mục đang đứng: luôn chạy từ backend/.
# Thứ tự lấy TỪNG biến: môi trường (kể cả đặt rỗng) -> backend/.env -> ../.env của bản Node -> mặc định trong code.
# Biến nào không có ở đây và không có trong môi trường thì lấy từ ../.env của bản Node (kể cả DATABASE_URL, webhook).
# Chạy trên database THỬ: đặt REPORT_JOB=0, PURCHASE_WEBHOOK và REPORT_WEBHOOK = http://127.0.0.1:9/x (giá trị phải khác rỗng).

# Cổng HTTP (mặc định 3000)
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/qspro
# Số kết nối tối đa của pool (mặc định 10)
DB_POOL_MAX=10
# Collation sắp xếp chữ có dấu (mặc định en-US-x-icu; database không có thì sắp theo mặc định của database)
DB_SORT_COLLATION=en-US-x-icu

# Khoá ký token đăng nhập - BẮT BUỘC đổi khi chạy thật, và phải giống bản Node nếu chạy song song
AUTH_SECRET=

# Lark: chỉ còn dùng để tải ảnh cũ qua /media
LARK_DOMAIN=https://open.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=

# Webhook Lark: yêu cầu mua hàng và báo cáo nhập sản phẩm (REPORT_WEBHOOK trống = dùng chung PURCHASE_WEBHOOK)
# CHÚ Ý: PURCHASE_WEBHOOK trống = webhook Lark THẬT ghi sẵn trong code (giống bản Node), tin sẽ vào group thật.
# Chạy thử: đặt cả hai thành địa chỉ giả (vd http://127.0.0.1:9/hook) và REPORT_JOB=0.
PURCHASE_WEBHOOK=
REPORT_WEBHOOK=

# Kho ảnh / tài liệu trên ổ đĩa máy chủ, phục vụ qua /files/<đường dẫn> (không cần đăng nhập).
# Trống = "uploads", tính từ thư mục đang đứng (tức backend/uploads). Docker: /app/uploads (volume uploads).
UPLOAD_DIR=

# Mã phiên bản đang chạy (header x-app-ver). Trống = thời điểm khởi động.
RENDER_GIT_COMMIT=
# Tài liệu API (Swagger) ở /api-docs và /api-docs.json: SWAGGER_DOCS=0 tắt, =1 bật.
# Để trống thì bật, trừ khi NODE_ENV=production (image Docker đặt sẵn NODE_ENV=production nên mặc định tắt).
SWAGGER_DOCS=
NODE_ENV=

# ---- Biến riêng của bản Go ----
# Job nền gửi báo cáo sản phẩm nhập mới lên Lark (gửi bù 70 giây sau khi chạy, rồi 8h00 thứ 4 và thứ 7).
# Mặc định BẬT; chỉ giá trị 0 mới tắt. Khi bản Node và bản Go chạy trên cùng database: đặt REPORT_JOB=0 ở bản Go,
# nếu không group Lark nhận hai báo cáo.
REPORT_JOB=

# Hạn phiên đăng nhập (ngày), chỉ bản Go. Trống = 7 ngày như bản Node.
TOKEN_TTL_DAYS=
# TUỲ CHỌN: thư mục giao diện cũ kiểu public/ của app Node (đã gỡ) và thư viện bảng tính của nó dưới /vendor
# (đường dẫn tương đối tính từ thư mục đang đứng, tức backend/). Trống = không phục vụ, không log gì.
# Spec ngành, logo, file mẫu nhập hàng loạt luôn có sẵn (nhúng trong binary), không cần thư mục này.
STATIC_DIR=
VENDOR_DIR=
# Origin được phép gọi API, cách nhau dấu phẩy. Trống = không bật CORS.
# Cũng là danh sách origin được mở WebSocket chat (/api/v1/chat/ws); cùng host với API luôn được.
CORS_ORIGINS=
# Giới hạn số request / giây theo IP. 0 = không giới hạn.
RATE_LIMIT_RPS=0
# Proxy được tin khi lấy IP client từ X-Forwarded-For (IP hoặc CIDR, cách nhau dấu phẩy). Trống = không tin proxy nào:
# IP là địa chỉ kết nối trực tiếp, nên đứng sau reverse proxy mà để trống thì mọi client chung một giới hạn.
TRUSTED_PROXIES=
# Redis cho giới hạn tần suất dùng chung nhiều tiến trình. Trống = đếm trong bộ nhớ.
REDIS_URL=
# 1 = bật log chi tiết của gin
DEBUG=

# ---- Chat (module chat: tài khoản theo số điện thoại + OTP, không dùng phiên QS) ----
# Khoá ký access token chat. Trống = suy ra từ AUTH_SECRET. Chạy thật: đặt chuỗi ngẫu nhiên dài, giữ bí mật.
# CHAT_JWT_SECRET=
# Hạn access token (phút) và refresh token (ngày). Trống = 15 / 30.
# CHAT_ACCESS_TTL_MIN=15
# CHAT_REFRESH_TTL_DAYS=30
# CHỈ giá trị 1 mới bật: API trả luôn mã OTP (dev_code) để thử ở máy. KHÔNG BAO GIỜ bật trên server thật.
# Chưa có nhà cung cấp SMS: mã OTP luôn được ghi vào log server.
# CHAT_OTP_DEV=0
# Web Push: sinh cặp khoá bằng "go run ./cmd/vapid" (từ backend/). Thiếu một trong ba biến = tắt push.
# CHAT_VAPID_SUBJECT là https://<tên miền> hoặc mailto:<email>. Khoá riêng là bí mật.
# CHAT_VAPID_PUBLIC_KEY=
# CHAT_VAPID_PRIVATE_KEY=
# CHAT_VAPID_SUBJECT=mailto:admin@example.com

# ---- Email (SMTP) ----
# Dùng gửi mã OTP khi đăng nhập Dezon Chat bằng email. Không đặt SMTP_HOST = không gửi email, mã OTP email ghi vào log server.
# SMTP_PORT trống = 587. Cổng 465 = TLS ngay khi kết nối; cổng khác (587, 25) tự nâng STARTTLS nếu máy chủ hỗ trợ.
# Có SMTP_USERNAME thì kết nối BẮT BUỘC đã mã hoá TLS (trừ máy chủ localhost / 127.0.0.1), không thì không gửi mật khẩu.
# Gmail / Google Workspace: SMTP_PASSWORD là "mật khẩu ứng dụng" (App Password), không phải mật khẩu đăng nhập.
# Mật khẩu có dấu # thì đặt trong nháy đơn: SMTP_PASSWORD='abc#123'.
# SMTP_FROM: người gửi hiện trong email; địa chỉ phải được máy chủ SMTP cho phép gửi (thường trùng SMTP_USERNAME).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Dezon Chat <no-reply@dezon.vn>
# DOTENV=0 (chỉ có tác dụng khi đặt trong MÔI TRƯỜNG, không phải trong file này): không đọc backend/.env lẫn ../.env.
# Dùng khi chạy thử trên database tạm để không thừa hưởng webhook / khoá thật của bản Node.
