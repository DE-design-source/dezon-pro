# Cấu hình production của QS Pro. setup-server.sh tự chép file này thành .env và sinh sẵn mật khẩu / khoá.
# Sửa: nano infra/deploy/.env    -> rồi: bash infra/deploy/deploy.sh
# KHÔNG commit file .env (đã có trong .gitignore).

# ---- Bắt buộc ----
# Tên miền đã trỏ bản ghi A về IP máy chủ (không có https://, không có "/" cuối). Vd: qs.dezon.vn
DOMAIN=
# (Tuỳ chọn) địa chỉ phụ tự chuyển về DOMAIN, vd www.dezon.tech (cần bản ghi A riêng trỏ về máy chủ). Trống = không dùng.
WWW_DOMAIN=
# Email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn...)
ACME_EMAIL=

# PostgreSQL chạy trong Docker trên chính máy chủ. Mật khẩu chỉ dùng chữ và số (nằm trong DATABASE_URL).
POSTGRES_USER=qspro
POSTGRES_PASSWORD=
POSTGRES_DB=qspro

# Khoá ký token đăng nhập (chuỗi ngẫu nhiên dài). Để trống thì không chạy.
# Đang có server cũ dùng chung database và muốn người dùng không phải đăng nhập lại: dùng đúng AUTH_SECRET của server cũ.
# Đổi khoá này = mọi người bị đăng xuất.
AUTH_SECRET=

# ---- Dịch vụ ngoài ----
# Webhook Lark nhận yêu cầu mua hàng / đề xuất; REPORT_WEBHOOK nhận báo cáo sản phẩm nhập mới (trống = dùng PURCHASE_WEBHOOK).
# CHÚ Ý: PURCHASE_WEBHOOK trống = dùng webhook Lark THẬT ghi sẵn trong code (group đang dùng).
PURCHASE_WEBHOOK=
REPORT_WEBHOOK=
# Job gửi báo cáo lên Lark (8h00 thứ 4 và thứ 7) + nhắc gia hạn công ty (8h05 hằng ngày).
# Trống = BẬT. Đặt 0 nếu server cũ (Render) vẫn còn chạy, để group Lark không nhận 2 báo cáo.
REPORT_JOB=
# Hạn phiên đăng nhập (ngày). Trống = 30 (đặt trong docker-compose.yml). Đổi xong chỉ áp cho lần đăng nhập sau.
TOKEN_TTL_DAYS=

# Kho ảnh / tài liệu: không cần cấu hình. File nằm trên ổ đĩa máy chủ, trong volume Docker "uploads"
# (backend phục vụ qua /files/...). backup-db.sh sao lưu cả file; "docker compose down -v" sẽ XOÁ volume này.

# Lark Open API: chỉ dùng để hiện ảnh cũ lưu trên Lark (/media). Lấy giá trị từ cấu hình server cũ (Render).
LARK_DOMAIN=
LARK_APP_ID=
LARK_APP_SECRET=

# ---- Tuỳ chọn ----
# Giới hạn số request / giây theo IP (0 hoặc trống = không giới hạn)
RATE_LIMIT_RPS=
# Số kết nối database tối đa của backend (trống = 10)
DB_POOL_MAX=
# Cổng PostgreSQL mở cho riêng máy chủ (127.0.0.1) để pgAdmin nối qua SSH tunnel
DB_LOCAL_PORT=5432
# Thư mục lưu bản sao lưu database và số ngày giữ lại
BACKUP_DIR=/opt/qspro-backups
BACKUP_KEEP_DAYS=14

# ---- Chỉ dùng khi chạy thử trên máy tính (production để trống) ----
# HTTP_PORT=8080
# HTTPS_PORT=8443
# PUBLIC_URL=https://localhost:8443
